MONGODB_URI=YOUR_MONGODB_URI
MONGODB_DB_NAME=video_pipeline

AZURE_STORAGE_CONNECTION_STRING=YOUR_CONNECTION_STRING
AZURE_CONTAINER_NAME=YOUR_CONTAINER_NAME

FOLDER_TEMP=temp
FOLDER_PROCESSED=processed
FOLDER_THUMBNAIL=thumbnails
FOLDER_HLS=hls

SERVICE_BUS_CONNECTION_STRING=YOUR_SERVICE_BUS_CONNECTION_STRING
SERVICE_BUS_QUEUE=YOUR_QUEUE

MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.avi,.webm
TARGET_MIN_SIZE_MB=20
TARGET_MAX_SIZE_MB=30

STORAGE_TEMP_DIR=storage/temp
STORAGE_PROCESSED_DIR=storage/processed
STORAGE_THUMBNAIL_DIR=storage/thumbnails

THUMBNAIL_OFFSET_SECONDS=10
HLS_SEGMENT_SECONDS=6

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

WORKER_MAX_CONCURRENT_MESSAGES=4
WORKER_POLL_WAIT_SECONDS=5
